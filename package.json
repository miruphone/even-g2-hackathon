{
  "name": "warden-g2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.16",
    "simulate": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "tgmock": "node tools/tgmock/server.ts",
    "server:mock": "node --env-file-if-exists=.env --env-file=.env.mock server/index.ts",
    "test": "node --test server/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "openai": "^7.64.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  }
}
